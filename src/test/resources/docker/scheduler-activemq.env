# ActiveMQ + MySQL Scheduler Configuration
SCHEDULER_INSTANCE_ID=scheduler-activemq
SCHEDULER_UI_NAME=ActiveMQ Scheduler
SCHEDULER_UI_COLOR=#D6242D

# Database (MySQL)
QUARKUS_DATASOURCE_DB_KIND=mysql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://mysql-scheduler-test:3306/scheduler
QUARKUS_DATASOURCE_USERNAME=scheduler
QUARKUS_DATASOURCE_PASSWORD=scheduler

# Use ActiveMQ routes instead of Kafka (camelCase property name)
CAMEL_MAIN_ROUTESINCLUDEPATTERN=classpath:camel/activemq.xml

# Camel ActiveMQ configuration (camelCase property names)
CAMEL_COMPONENT_ACTIVEMQ_BROKERURL=tcp://activemq-scheduler-test:61616
CAMEL_COMPONENT_ACTIVEMQ_USERNAME=admin
CAMEL_COMPONENT_ACTIVEMQ_PASSWORD=admin

# ActiveMQ queues - per-flavor isolation
SCHEDULER_IN=activemq:queue:scheduler-in-activemq
SCHEDULER_DLQ=activemq:queue:scheduler-dlq-activemq
SCHEDULER_ADVISORY=activemq:topic:scheduler-advisory-activemq
SCHEDULER_ADVISORY_DLQ=activemq:queue:scheduler-advisory-dlq-activemq
SCHEDULER_CONSUMER_GROUP=scheduler-activemq
