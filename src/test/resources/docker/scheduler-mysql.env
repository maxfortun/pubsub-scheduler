# MySQL Scheduler Configuration
SCHEDULER_INSTANCE_ID=scheduler-mysql
SCHEDULER_UI_NAME=MySQL Scheduler
SCHEDULER_UI_COLOR=#F29111

# Database
QUARKUS_DATASOURCE_DB_KIND=mysql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:mysql://mysql-scheduler-test:3306/scheduler
QUARKUS_DATASOURCE_USERNAME=scheduler
QUARKUS_DATASOURCE_PASSWORD=scheduler

# Kafka - per-flavor isolation
KAFKA_BOOTSTRAP_SERVERS=pubsub-scheduler-test:29092
CAMEL_COMPONENT_KAFKA_BROKERS=pubsub-scheduler-test:29092
SCHEDULER_IN=kafka:scheduler-in-mysql
SCHEDULER_DLQ=kafka:scheduler-dlq-mysql
SCHEDULER_ADVISORY=kafka:scheduler-advisory-mysql
SCHEDULER_ADVISORY_DLQ=kafka:scheduler-advisory-dlq-mysql
SCHEDULER_CONSUMER_GROUP=scheduler-mysql
