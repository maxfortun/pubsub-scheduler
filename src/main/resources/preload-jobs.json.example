[
  {
    "jobKey": "scheduler-heartbeat",
    "destination": "scheduler-advisory",
    "keyPolicy": "SKIP",
    "sleepDuration": "PT15M",
    "sleepRepeat": 0,
    "headers": {
      "scheduler_internal_job": "true"
    },
    "body": "{\"type\":\"SCHEDULER_HEARTBEAT\"}",
    "maxRetries": 3
  }
]
