# CockroachDB Scheduler Configuration
SCHEDULER_INSTANCE_ID=scheduler-cockroach
SCHEDULER_UI_NAME=CockroachDB Scheduler
SCHEDULER_UI_COLOR=#6933FF

# Database
QUARKUS_DATASOURCE_DB_KIND=postgresql
SCHEDULER_DB_DIALECT=cockroachdb
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://cockroachdb-scheduler-test:26257/scheduler?sslmode=disable
QUARKUS_DATASOURCE_USERNAME=scheduler
QUARKUS_DATASOURCE_PASSWORD=scheduler

# Kafka - per-flavor isolation
KAFKA_BOOTSTRAP_SERVERS=pubsub-scheduler-test:29092
CAMEL_COMPONENT_KAFKA_BROKERS=pubsub-scheduler-test:29092
SCHEDULER_IN=kafka:scheduler-in-cockroach
SCHEDULER_DLQ=kafka:scheduler-dlq-cockroach
SCHEDULER_ADVISORY=kafka:scheduler-advisory-cockroach
SCHEDULER_ADVISORY_DLQ=kafka:scheduler-advisory-dlq-cockroach
SCHEDULER_CONSUMER_GROUP=scheduler-cockroach
