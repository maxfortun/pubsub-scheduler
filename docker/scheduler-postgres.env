# PostgreSQL Scheduler Configuration
SCHEDULER_INSTANCE_ID=scheduler-postgres
SCHEDULER_UI_NAME=PostgreSQL Scheduler
SCHEDULER_UI_COLOR=#336791

# Database
QUARKUS_DATASOURCE_DB_KIND=postgresql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres-scheduler-test:5432/scheduler
QUARKUS_DATASOURCE_USERNAME=scheduler
QUARKUS_DATASOURCE_PASSWORD=scheduler

# Kafka - per-flavor isolation
KAFKA_BOOTSTRAP_SERVERS=pubsub-scheduler-test:29092
CAMEL_COMPONENT_KAFKA_BROKERS=pubsub-scheduler-test:29092
SCHEDULER_IN=kafka:scheduler-in-postgres
SCHEDULER_DLQ=kafka:scheduler-dlq-postgres
SCHEDULER_ADVISORY=kafka:scheduler-advisory-postgres
SCHEDULER_ADVISORY_DLQ=kafka:scheduler-advisory-dlq-postgres
SCHEDULER_CONSUMER_GROUP=scheduler-postgres
