      "fontFamily": 3
    },
    {
      "id": "use-case",
      "type": "text",
      "x": 50,
      "y": 550,
      "width": 900,
      "height": 40,
      "text": "Use PREV when: API rate limits (1 req/min), resource cooldowns, ensuring processing gap.\nUse SELF when: Fixed schedule regardless of duration, parallel-safe operations.",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#495057"
    }
